<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Centrado y escalado dentro de la zona segura de Adaptive Icon (66dp centrales de 108dp) -->
    <!-- La mariposa original ocupa X:[9..91], Y:[19..89] (centro 50,54). Con scale 0.56 alrededor de (50,54) y traslado (+4, 0) queda perfectamente proporcionada en (54,54) -->
    <group
        android:pivotX="50"
        android:pivotY="54"
        android:scaleX="0.58"
        android:scaleY="0.58"
        android:translateX="4"
        android:translateY="0">

        <!-- Ala superior izquierda -->
        <path android:pathData="M 50 48 C 45 28 22 15 12 25 C 2 35 10 58 35 60 C 44 61 48 53 50 48 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="50"
                    android:endY="62"
                    android:startX="8"
                    android:startY="18"
                    android:type="linear">
                    <item
                        android:color="#FF65A5"
                        android:offset="0.0" />
                    <item
                        android:color="#C73FA7"
                        android:offset="0.55" />
                    <item
                        android:color="#7928CA"
                        android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Ala inferior izquierda -->
        <path android:pathData="M 48 54 C 40 60 20 62 16 75 C 12 88 30 94 42 82 C 47 77 48 64 48 54 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="16"
                    android:endY="90"
                    android:startX="48"
                    android:startY="54"
                    android:type="linear">
                    <item
                        android:color="#FFB2D9"
                        android:offset="0.0" />
                    <item
                        android:color="#FF4081"
                        android:offset="0.5" />
                    <item
                        android:color="#B80058"
                        android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Ala superior derecha -->
        <path android:pathData="M 50 48 C 55 28 78 15 88 25 C 98 35 90 58 65 60 C 56 61 52 53 50 48 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="50"
                    android:endY="62"
                    android:startX="92"
                    android:startY="18"
                    android:type="linear">
                    <item
                        android:color="#FF65A5"
                        android:offset="0.0" />
                    <item
                        android:color="#C73FA7"
                        android:offset="0.55" />
                    <item
                        android:color="#7928CA"
                        android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Ala inferior derecha -->
        <path android:pathData="M 52 54 C 60 60 80 62 84 75 C 88 88 70 94 58 82 C 53 77 52 64 52 54 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="84"
                    android:endY="90"
                    android:startX="52"
                    android:startY="54"
                    android:type="linear">
                    <item
                        android:color="#FFB2D9"
                        android:offset="0.0" />
                    <item
                        android:color="#FF4081"
                        android:offset="0.5" />
                    <item
                        android:color="#B80058"
                        android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Cuerpo y antenas -->
        <path
            android:pathData="M 50 40 L 50 75"
            android:strokeColor="#4A154B"
            android:strokeLineCap="round"
            android:strokeWidth="3.4" />
        <path
            android:fillColor="#4A154B"
            android:pathData="M 50,36 m -3.3,0 a 3.3,3.3 0 1,0 6.6,0 a 3.3,3.3 0 1,0 -6.6,0" />
        <path
            android:pathData="M 49 34 C 46 28 41 26 38 28"
            android:strokeColor="#4A154B"
            android:strokeLineCap="round"
            android:strokeWidth="2.3" />
        <path
            android:pathData="M 51 34 C 54 28 59 26 62 28"
            android:strokeColor="#4A154B"
            android:strokeLineCap="round"
            android:strokeWidth="2.3" />
    </group>
</vector>
